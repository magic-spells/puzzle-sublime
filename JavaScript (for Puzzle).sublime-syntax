%YAML 1.2
---
# JavaScript expression grammar used only inside Puzzle template braces.
# Extending Sublime's native JavaScript grammar gives expressions the same
# highlighting as a .js file while allowing Puzzle formatter pipes and range
# loops to receive framework-specific scopes.
scope: source.js.embedded.puzzle
version: 2
hidden: true

extends: Packages/JavaScript/JavaScript.sublime-syntax

variables:
  # isFormatterName in the compiler: an ASCII identifier, optionally
  # kebab-case, where every `-` starts a word with a letter (`blank-ish`).
  # `bit-1`, `a--b` and `a-` are not names, and neither is anything dotted.
  puzzle_formatter_name: '[A-Za-z_$][A-Za-z0-9_$]*(?:-[A-Za-z][A-Za-z0-9_$]*)*'
  # The end of a formatter name: a longer name (`raw_text`, `rawValue`,
  # `raw-ish`) is a different formatter, not a markup one.
  puzzle_formatter_name_break: '(?![A-Za-z0-9_$]|-[A-Za-z])'
  # The markup formatters (D174): legal only as the last link of a text
  # interpolation's chain, bare, with no arguments.
  puzzle_markup_formatter: '(?:raw|newline_to_br){{puzzle_formatter_name_break}}'
  # A formatter pipe is a single `|`: `||` stays logical OR, `|=` and `||=`
  # stay assignment. No lookbehind is needed (and Sublime's sregex engine does
  # not support one): binary-operators consumes `||` whole, so its second
  # character is never a match position.
  puzzle_pipe: '\|(?![|=])'
  # What follows a pipe must be a formatter name, bare or called, and then the
  # end of the chain step: `(`, the next `|`, the closing `}`, or the end of the
  # line (a chain continued below). Anything else — `| 0`, `| f g`, `| f.g`,
  # `|= 2` — is a compile error (notFormatterError in the compiler).
  puzzle_formatter_step: '\s*{{puzzle_formatter_name}}\s*(?:[(|}]|$)'

contexts:
  # Entry points. The Puzzle grammar includes exactly one of these per brace
  # position, and never JavaScript's own `expressions`:
  #
  #   puzzle-expressions         a text interpolation. A top-level `|` is a
  #                              formatter pipe (D173 V1), and the chain may
  #                              end in a markup formatter (`raw`,
  #                              `newline_to_br`).
  #   puzzle-attribute-expressions
  #                              every other value position — quoted and
  #                              brace-only attribute values, component
  #                              props, marker arguments, key= and flip=. A
  #                              top-level `|` is a formatter pipe, but a
  #                              markup formatter is a compile error there.
  #   puzzle-nopipe-expressions  every block header: {#if}, {:else if},
  #                              {#unless} and {#case} conditions (inline
  #                              attribute {#if} included), the {#for} header
  #                              and {:when} values. A top-level `|` there is
  #                              a compile error; `||` is still logical OR.
  #   expressions (native)       @event handler bodies: JavaScript, except
  #                              that a single `|` is a compile error there
  #                              too (see binary-operators below).
  #
  # "Top-level" is the compiler's rule (splitTopLevel): a `|` inside a string,
  # regex, parentheses, brackets or braces is not a split point. Only the
  # outermost expression-end frame below knows about formatter pipes; every
  # nested frame — a group, call or formatter arguments, an array, an object
  # literal, a subscript — is pushed by native JavaScript rules with the native
  # expression-end, whose binary-operators flag a single `|` as the nested-pipe
  # error (D176: there is no bitwise OR in templates). That is also why
  # `{ t({ name: user.name }) }` needs no special handling: the inner braces are
  # JavaScript's own object literal and balance there, so the interpolation
  # still closes on the outer `}`.
  puzzle-expressions:
    - match: '(?=\S)'
      push: [puzzle-expression-end, expression-begin]

  puzzle-attribute-expressions:
    - match: '(?=\S)'
      push: [puzzle-attribute-expression-end, expression-begin]

  puzzle-nopipe-expressions:
    - match: '(?=\S)'
      push: [puzzle-nopipe-expression-end, expression-begin]

  # JavaScript's expression-end with the formatter pipe in front. Binary
  # operators push expression-begin on top of this frame, so it survives the
  # whole top-level expression; the ternary replaces its frame with `set`, so
  # it has a Puzzle copy that restores this one after the `:`.
  puzzle-expression-end:
    - include: puzzle-invalid-pipe
    - match: '{{puzzle_pipe}}'
      scope: keyword.operator.formatter.puzzle
      push: puzzle-formatter-name
    - include: puzzle-range-operator
    - include: postfix-operators
    - include: binary-operators
    - include: puzzle-ternary-operator
    - include: left-expression-end

  # The same frame for an attribute-side value; only the formatter-name context
  # it pushes differs, and its ternary restores this frame after the `:`.
  puzzle-attribute-expression-end:
    - include: puzzle-invalid-pipe
    - match: '{{puzzle_pipe}}'
      scope: keyword.operator.formatter.puzzle
      push: puzzle-attribute-formatter-name
    - include: puzzle-range-operator
    - include: postfix-operators
    - include: binary-operators
    - include: puzzle-attribute-ternary-operator
    - include: left-expression-end

  puzzle-nopipe-expression-end:
    - include: puzzle-invalid-pipe
    # Every top-level pipe is an error here, so the name after it is read as
    # plain JavaScript rather than given the formatter scope.
    - match: '{{puzzle_pipe}}'
      scope: invalid.illegal.formatter.puzzle
      push: expression-begin
    - include: puzzle-range-operator
    - include: postfix-operators
    - include: binary-operators
    - include: puzzle-nopipe-ternary-operator
    - include: left-expression-end

  # A pipe in a value position that cannot start a formatter step. Listed
  # ahead of binary-operators, which would otherwise read it as bitwise OR or
  # `|=` assignment. The operand after it is ordinary JavaScript.
  puzzle-invalid-pipe:
    - match: '\|='
      scope: invalid.illegal.formatter.puzzle
      push: expression-begin
    - match: '\|(?![|=])(?!{{puzzle_formatter_step}})'
      scope: invalid.illegal.formatter.puzzle
      push: expression-begin

  puzzle-ternary-operator:
    - match: '\?(?=[^.]|\.[0-9])'
      scope: keyword.operator.ternary.js
      set:
        - puzzle-ternary-operator-expect-colon
        - expression-no-comma

  puzzle-ternary-operator-expect-colon:
    - match: ':'
      scope: keyword.operator.ternary.js
      set: [puzzle-expression-end, expression-begin]
    - include: else-pop

  puzzle-attribute-ternary-operator:
    - match: '\?(?=[^.]|\.[0-9])'
      scope: keyword.operator.ternary.js
      set:
        - puzzle-attribute-ternary-operator-expect-colon
        - expression-no-comma

  puzzle-attribute-ternary-operator-expect-colon:
    - match: ':'
      scope: keyword.operator.ternary.js
      set: [puzzle-attribute-expression-end, expression-begin]
    - include: else-pop

  puzzle-nopipe-ternary-operator:
    - match: '\?(?=[^.]|\.[0-9])'
      scope: keyword.operator.ternary.js
      set:
        - puzzle-nopipe-ternary-operator-expect-colon
        - expression-no-comma

  puzzle-nopipe-ternary-operator-expect-colon:
    - match: ':'
      scope: keyword.operator.ternary.js
      set: [puzzle-nopipe-expression-end, expression-begin]
    - include: else-pop

  # A single `|` below the top level of a template value — inside a group, call
  # or formatter arguments, a subscript, an array or an object literal, or in
  # a ternary's middle branch — is a compile error (D176 rule 4): there is no
  # bitwise OR in templates, and a formatter pipe must be at the top level.
  # An @event handler body rejects a single `|` as well. The top-level frames
  # above match their own pipes before they reach this context, so this rule
  # only ever sees the nested ones and the handler's. `||` and `|=` keep their
  # native meaning: binary-operators consumes them before this pattern is
  # tried at their second character, and the lookahead skips their first.
  # Nothing here reaches a <script> section, which embeds native JavaScript.
  binary-operators:
    - meta_prepend: true
    - match: '{{puzzle_pipe}}'
      scope: invalid.illegal.formatter.puzzle
      push: expression-begin

  # Puzzle's inclusive range form: {#for 1...5, n}
  puzzle-range-operator:
    - match: '\.\.\.'
      scope: keyword.operator.range.puzzle
      push: expression-begin

  expression-begin:
    - meta_prepend: true
    # Native JavaScript accepts `1.` as a float, so without this guard it eats
    # the first dot in Puzzle's `1...4` range before the range operator can be
    # seen. Pop exactly like JavaScript's native number rules do.
    - match: '{{dec_integer}}(?=\.\.\.)'
      scope: meta.number.integer.decimal.js constant.numeric.value.js
      pop: 1

  # The name after a pipe, bare or called: `| trim`, `| currency('$', 2)`. The
  # argument list is matched afterwards by the frame underneath, as an ordinary
  # call, so object-literal arguments (`| t({ name })`) are native JavaScript.
  #
  # In a text interpolation, `raw` and `newline_to_br` are ordinary names when
  # they end the chain: nothing but the closing `}` may follow (or the end of
  # the line, where the chain may continue below and the grammar cannot see
  # it). Followed by another formatter or by arguments, the name is the
  # compile error — markup is no formatter's input, and neither takes
  # arguments.
  puzzle-formatter-name:
    - meta_include_prototype: false
    - match: '\s*({{puzzle_markup_formatter}})(?=\s*(?:\}|$))'
      captures:
        1: variable.function.formatter.puzzle
      pop: 1
    - match: '\s*({{puzzle_markup_formatter}})'
      captures:
        1: invalid.illegal.markup-formatter.puzzle
      pop: 1
    - include: puzzle-formatter-name-common

  # In every other value position a markup formatter is always the error: its
  # output is markup, which only a text position can render.
  puzzle-attribute-formatter-name:
    - meta_include_prototype: false
    - match: '\s*({{puzzle_markup_formatter}})'
      captures:
        1: invalid.illegal.markup-formatter.puzzle
      pop: 1
    - include: puzzle-formatter-name-common

  puzzle-formatter-name-common:
    - match: '\s*({{puzzle_formatter_name}})'
      captures:
        1: variable.function.formatter.puzzle
      pop: 1
    - include: else-pop
