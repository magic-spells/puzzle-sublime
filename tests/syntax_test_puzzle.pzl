## SYNTAX TEST "Puzzle.sublime-syntax"

<puzzle-view class="shell">
##^^^^^^^^^^ entity.name.tag.section.puzzle
##           ^^^^^ entity.other.attribute-name.class.html

  <article
 ##^^^^^^^ entity.name.tag.block.any.html
    id="profile"
  ##^^ entity.other.attribute-name.id.html
    data-user={ user.id }
  ##^^^^^^^^^ entity.other.attribute-name.html
    ##        ^ punctuation.section.embedded.begin.puzzle
    ##             ^^^^ source.js.embedded.puzzle
    style="{#if visible}opacity:{ opacity };{/if} transform:translateX({ offset }px)">
  ##^^^^^ entity.other.attribute-name.style.html
    ##     ^ punctuation.section.embedded.begin.puzzle
    ##      ^ punctuation.definition.keyword.puzzle
    ##       ^^ keyword.control.conditional.puzzle
    ##                  ^^^^^^^ support.type.property-name.css
    ##                          ^ punctuation.section.embedded.begin.puzzle
    ##                           ^^^^^^^ source.js.embedded.puzzle

    <!-- {#if examplesInComments} stays a comment {/if} -->
  ##^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ comment.block.html
    ##      ^ - meta.embedded.block.puzzle

    <ArtistCard @click:prevent:stop={ openArtist(artist, event) } />
   ##^^^^^^^^^^ entity.name.tag.component.puzzle
    ##          ^ keyword.operator.event.puzzle
    ##           ^^^^^ entity.other.attribute-name.event.puzzle
    ##                ^ punctuation.separator.modifier.puzzle
    ##                 ^^^^^^^ support.constant.event-modifier.puzzle
    ##                        ^ punctuation.separator.modifier.puzzle
    ##                         ^^^^ support.constant.event-modifier.puzzle
    ##                              ^ punctuation.section.embedded.begin.puzzle

    <button @click.prevent={ broken } @click:bogus={ alsoBroken }>
    ##      ^ keyword.operator.event.puzzle
    ##       ^^^^^ entity.other.attribute-name.event.puzzle
    ##            ^^^^^^^^ invalid.illegal.event-modifier.puzzle
    ##                                ^ keyword.operator.event.puzzle
    ##                                 ^^^^^ entity.other.attribute-name.event.puzzle
    ##                                      ^ punctuation.separator.modifier.puzzle
    ##                                       ^^^^^ invalid.illegal.event-modifier.puzzle
      Open
    </button>

    {#if user.active && !user.suspended}
  ##^ punctuation.section.embedded.begin.puzzle
   ##^ punctuation.definition.keyword.puzzle
    ##^^ keyword.control.conditional.puzzle
    ##      ^^^^ source.js.embedded.puzzle
    ##                  ^ keyword.operator.logical.js
      <strong>{ capitalize(user.name.trim()) }</strong>
##            ^ punctuation.section.embedded.begin.puzzle
##              ^^^^^^^^^^ support.function.library.puzzle
##                                   ^^^^ variable.function.js
##                                           ^ punctuation.section.embedded.end.puzzle
    {:else if user.pending}
  ##^ punctuation.section.embedded.begin.puzzle
   ##^ punctuation.definition.keyword.puzzle
    ##^^^^ keyword.control.conditional.else.puzzle
    ##     ^^ keyword.control.conditional.if.puzzle
      <span>Pending</span>
    {:else}
   ##^ punctuation.definition.keyword.puzzle
    ##^^^^ keyword.control.conditional.else.puzzle
      <span>Inactive</span>
    {/if}
   ##^ punctuation.definition.keyword.puzzle
    ##^^ keyword.control.end.puzzle

    {#unless hidden}
   ##^ punctuation.definition.keyword.puzzle
    ##^^^^^^ keyword.control.conditional.puzzle
      <span>Visible</span>
    {/unless}
    ##^^^^^^ keyword.control.end.puzzle

    {#case status}
   ##^ punctuation.definition.keyword.puzzle
    ##^^^^ keyword.control.conditional.puzzle
      {:when 'playing', 'paused'}<span>{ status }</span>
     ##^ punctuation.definition.keyword.puzzle
      ##^^^^ keyword.control.conditional.puzzle
      ##     ^^^^^^^^^ source.js.embedded.puzzle string.quoted.single.js
      {:else}<span>Unknown</span>
    {/case}
    ##^^^^ keyword.control.end.puzzle

    {#for track in tracks, i}
   ##^ punctuation.definition.keyword.puzzle
    ##^^^ keyword.control.loop.puzzle
    ##          ^^ keyword.operator.js
      <span>{ i }: { track.title }</span>
    {/for}
    ##^^^ keyword.control.end.puzzle

    {#for 1...4, n}<i>{ n }</i>{/for}
    ##        ^ constant.numeric.value.js
    ##     ^^^ keyword.operator.range.puzzle
    ##        ^ constant.numeric.value.js
    ##                           ^^^ keyword.control.end.puzzle

    ## a counterless range header is the same shape

    {#for 1...5}<b>x</b>{/for}
    ##^^^ keyword.control.loop.puzzle
    ##    ^ constant.numeric.value.js
    ##     ^^^ keyword.operator.range.puzzle
    ##        ^ constant.numeric.value.js

    ## `{#for i in 1...5}` is a compile error in 0.7.0 -- write `{#for 1...5, i}`
    ## instead. The grammar does not flag it, but the range operator must still
    ## read as one token rather than eating the digits around it.

    {#for i in 1...5}<b>x</b>{/for}
    ##^^^ keyword.control.loop.puzzle
    ##      ^^ keyword.operator.js
    ##         ^ constant.numeric.value.js
    ##          ^^^ keyword.operator.range.puzzle
    ##             ^ constant.numeric.value.js

    {#svg 'icons/heart.svg'}
   ##^ punctuation.definition.keyword.puzzle
    ##^^^ support.function.inline-svg.puzzle
    ##    ^^^^^^^^^^^^^^^^^ string.quoted.single.js

    <p title="Hello { user.name }">{ count || fallback }</p>
    ##              ^ punctuation.section.embedded.begin.puzzle
    ##                  ^^^^ source.js.embedded.puzzle
    ##                                     ^^ keyword.operator.logical.js
    ##                                     ^^ - invalid


    ## --- Template comments (v1.37, D70) --- stripped by compiler, never parsed

    {## a simple comment }
  ##^^^ comment.block.template.puzzle
  ##^ punctuation.definition.comment.begin.puzzle
    ##    ^^^^^^ comment.block.template.puzzle
    ##                   ^ punctuation.definition.comment.end.puzzle

    {## don't { x } \} end }
    ##     ^ comment.block.template.puzzle
    ##        ^ comment.block.template.puzzle
    ##            ^ comment.block.template.puzzle
    ##              ^^ comment.block.template.puzzle
    ##               ^ - punctuation.definition.comment.end.puzzle
    ##                     ^ punctuation.definition.comment.end.puzzle

    {#comment} { x } {#if a}z{/if} <!-- h --> {/comment}
  ##^^^^^^^^^ comment.block.puzzle
  ##^^^ punctuation.definition.comment.begin.puzzle
    ##         ^^^^^ comment.block.puzzle
    ##                 ^^ comment.block.puzzle
    ##                 ^^ - keyword.control.conditional.puzzle
    ##                             ^^^^ comment.block.puzzle
    ##                                        ^ punctuation.definition.comment.end.puzzle
    ##                                                 ^ punctuation.definition.comment.end.puzzle

    {#comment} outer {#comment} inner {/comment} outer {/comment}
  ##^^^^^^^^^ comment.block.puzzle
    ##               ^^^^^^^^^ comment.block.puzzle
    ##               ^^^ punctuation.definition.comment.begin.puzzle
    ##                          ^^^^^ comment.block.puzzle
    ##                                ^ punctuation.definition.comment.end.puzzle
    ##                                           ^^^^^ comment.block.puzzle
    ##                                                 ^ punctuation.definition.comment.end.puzzle

    {#comment note} body {/ comment }
  ##^^^^^^^^^ comment.block.puzzle
    ##        ^^^^ comment.block.puzzle
    ##              ^^^^ comment.block.puzzle
    ##                   ^ punctuation.definition.comment.end.puzzle
    ##                              ^ punctuation.definition.comment.end.puzzle

    {#commentary}
   ##^ punctuation.definition.keyword.puzzle
    ##^^^^^^^^^^ invalid.illegal.directive.puzzle
    ##^^^^^^^^^^ - comment.block.puzzle


    ## --- Paired composition markers (D141) --- Children, Slot and Portal are
    ## reserved markers, not components; fallback bodies are ordinary content

    <Slot name="header"><h2>{ capitalize(title) }</h2></Slot>
##   ^^^^ entity.name.tag.marker.puzzle
##   ^^^^ - entity.name.tag.component.puzzle
##                          ^ punctuation.section.embedded.begin.puzzle
##                            ^^^^^^^^^^ support.function.library.puzzle
##                                       ^^^^^ source.js.embedded.puzzle
##                                                      ^^^^ entity.name.tag.marker.puzzle
    <Children>
   ##^^^^^^^^ entity.name.tag.marker.puzzle
      {#if items.length}<ItemCard item={ items[0] } />{:else}<p>plain</p>{/if}
##      ^^ keyword.control.conditional.puzzle
##         ^^^^^^^^^^^^ source.js.embedded.puzzle
##                       ^^^^^^^^ entity.name.tag.component.puzzle
##                                       ^^^^^^^^ source.js.embedded.puzzle
##                                                      ^^^^ keyword.control.conditional.else.puzzle
##                                                              ^^^^^ - source.js.embedded.puzzle
##                                                                         ^^ keyword.control.end.puzzle
    </Children>
    ##^^^^^^^^ entity.name.tag.marker.puzzle

    <Slot>{ number_with_delimiter(count) } left{#svg 'icons/empty.svg'}</Slot>
##   ^^^^ entity.name.tag.marker.puzzle
##          ^^^^^^^^^^^^^^^^^^^^^ support.function.library.puzzle
##                                ^^^^^ source.js.embedded.puzzle
##                                         ^^^^ - source.js.embedded.puzzle
##                                               ^^^ support.function.inline-svg.puzzle
##                                                                       ^^^^ entity.name.tag.marker.puzzle

    <Children/><Slot name="footer"/>
   ##^^^^^^^^ entity.name.tag.marker.puzzle
    ##          ^^^^ entity.name.tag.marker.puzzle

    <Portal><div class="dialog">{ message }</div></Portal>
   ##^^^^^^ entity.name.tag.marker.puzzle
    ##       ^^^ entity.name.tag.block.any.html
    ##                          ^ punctuation.section.embedded.begin.puzzle
    ##                            ^^^^^^^ source.js.embedded.puzzle
    ##                                             ^^^^^^ entity.name.tag.marker.puzzle

    ## --- Snippets (D166) --- <Snippet> is a caller-side marker; `fits`
    ## routes it to a named position and every other attribute is a bare
    ## parameter declaration

    <UserList users={ users }>
   ##^^^^^^^^ entity.name.tag.component.puzzle
      <Snippet fits="row" user group><b>{ user.name }</b></Snippet>
    ## ^^^^^^^ entity.name.tag.marker.puzzle
    ## ^^^^^^^ - entity.name.tag.component.puzzle
    ##         ^^^^ entity.other.attribute-name.html
    ##                    ^^^^ entity.other.attribute-name.html
    ##                         ^^^^^ entity.other.attribute-name.html
    ##                                    ^^^^^^^^^ source.js.embedded.puzzle
    ##                                                     ^^^^^^^ entity.name.tag.marker.puzzle
      <Snippet user><b>{ user.name }</b></Snippet>
    ## ^^^^^^^ entity.name.tag.marker.puzzle
    ##         ^^^^ entity.other.attribute-name.html
    ##                   ^^^^^^^^^ source.js.embedded.puzzle
    ##                                    ^^^^^^^ entity.name.tag.marker.puzzle
    </UserList>
    ##^^^^^^^^ entity.name.tag.component.puzzle

    ## a marker hands values out per stamp: on <Slot>/<Children> a valued
    ## attribute is an argument, and the paired body stays a D141 fallback

    <Slot name="row" user={ user }>none</Slot>
   ##^^^^ entity.name.tag.marker.puzzle
    ##               ^^^^ entity.other.attribute-name.html
    ##                      ^^^^ source.js.embedded.puzzle
    ##                                   ^^^^ entity.name.tag.marker.puzzle

    <Children user={ user }>fallback</Children>
   ##^^^^^^^^ entity.name.tag.marker.puzzle
    ##        ^^^^ entity.other.attribute-name.html
    ##             ^ punctuation.section.embedded.begin.puzzle
    ##               ^^^^ source.js.embedded.puzzle
    ##                                ^^^^^^^^ entity.name.tag.marker.puzzle

    ## a lowercase <snippet> is NOT flagged: the parser only steers it to
    ## <Snippet> when it carries `fits` or a bare parameter, so a plain one is
    ## ordinary markup. <slot>/<children>/<portal> always error; this does not.

    <snippet class="sample">ordinary</snippet>
   ##^^^^^^^ entity.name.tag.other.html
   ##^^^^^^^ - invalid.illegal.marker.puzzle
   ##^^^^^^^ - entity.name.tag.marker.puzzle

    ## a capitalized name that merely starts with a marker word is a component

    <Slotted/><PortalHost/><SnippetHost/>
   ##^^^^^^^ entity.name.tag.component.puzzle
    ##         ^^^^^^^^^^ entity.name.tag.component.puzzle
    ##                      ^^^^^^^^^^^ entity.name.tag.component.puzzle


    ## --- Component families: dotted component tags (D167) --- a component
    ## tag name is a member path, emitted verbatim as a JS member expression

    <Frame.Wrapper class="dotted">
   ##^^^^^^^^^^^^^ entity.name.tag.component.puzzle
      <Frame.Content>{ title }</Frame.Content>
     ##^^^^^^^^^^^^^ entity.name.tag.component.puzzle
      ##                        ^^^^^^^^^^^^^ entity.name.tag.component.puzzle
      <Frame.Inner.Deep/>
     ##^^^^^^^^^^^^^^^^ entity.name.tag.component.puzzle
    </Frame.Wrapper>
    ##^^^^^^^^^^^^^ entity.name.tag.component.puzzle

    ## a dotted name rooted at a marker word is a component, not a marker:
    ## markers are exact-match names, so <Slot.Custom/> falls through

    <Slot.Custom/>
   ##^^^^^^^^^^^ entity.name.tag.component.puzzle
   ##^^^^^^^^^^^ - entity.name.tag.marker.puzzle


    ## --- Lowercase marker spellings are compile errors (D134/D144) ---

    <slot></slot><children/><portal></portal>
   ##^^^^ invalid.illegal.marker.puzzle
   ##^^^^ - entity.name.tag.block.any.html
    ##      ^^^^ invalid.illegal.marker.puzzle
    ##            ^^^^^^^^ invalid.illegal.marker.puzzle
    ##                       ^^^^^^ invalid.illegal.marker.puzzle
    ##                                ^^^^^^ invalid.illegal.marker.puzzle


    ## --- Directive attributes --- intercepted by the compiler, never DOM

    <li key={ item.id } ref="row" island flip>
    ##  ^^^ entity.other.attribute-name.directive.puzzle
    ##      ^ punctuation.section.embedded.begin.puzzle
    ##        ^^^^^^^ source.js.embedded.puzzle
    ##                  ^^^ entity.other.attribute-name.directive.puzzle
    ##                      ^^^^^ string.quoted.double.html
    ##                            ^^^^^^ entity.other.attribute-name.directive.puzzle
    ##                                   ^^^^ entity.other.attribute-name.directive.puzzle
      done
    </li>

    <tr key="row-{ i }" flip={ track.id }>
    ##  ^^^ entity.other.attribute-name.directive.puzzle
    ##           ^ punctuation.section.embedded.begin.puzzle
    ##             ^ source.js.embedded.puzzle
    ##                  ^^^^ entity.other.attribute-name.directive.puzzle
    ##                         ^^^^^^^^ source.js.embedded.puzzle
      <td>cell</td>
    </tr>

    ## a directive word inside a longer name stays a plain attribute

    <div data-ref="x" keyboard="y"></div>
    ##   ^^^^^^^^ - entity.other.attribute-name.directive.puzzle
    ##                ^^^^^^^^ - entity.other.attribute-name.directive.puzzle


    ## --- The outside event modifier (v1.52, D86) is event-generic ---

    <div @click:outside={ close } @pointerdown:outside:once={ close }>
    ##   ^ keyword.operator.event.puzzle
    ##    ^^^^^ entity.other.attribute-name.event.puzzle
    ##         ^ punctuation.separator.modifier.puzzle
    ##          ^^^^^^^ support.constant.event-modifier.puzzle
    ##                            ^ keyword.operator.event.puzzle
    ##                             ^^^^^^^^^^^ entity.other.attribute-name.event.puzzle
    ##                                        ^ punctuation.separator.modifier.puzzle
    ##                                         ^^^^^^^ support.constant.event-modifier.puzzle
    ##                                                ^ punctuation.separator.modifier.puzzle
    ##                                                 ^^^^ support.constant.event-modifier.puzzle
    </div>

    <div @click.outside={ broken }></div>
    ##         ^^^^^^^^ invalid.illegal.event-modifier.puzzle


    ## --- Raw blocks (D150) --- braces inert, HTML still structural

    {#raw}{ "loop": true } {#if x}{:else}{/if} { a | this }{/raw}
##  ^ punctuation.section.embedded.begin.puzzle
##   ^ punctuation.definition.keyword.puzzle
##    ^^^ keyword.control.raw.puzzle
##       ^ punctuation.section.embedded.end.puzzle
##        ^ - punctuation.section.embedded.begin.puzzle
##          ^^^^^^ - source.js.embedded.puzzle
##                           ^^ - keyword.control.conditional.puzzle
##                                  ^^^^ - keyword.control.conditional.else.puzzle
##                                         ^^ - keyword.control.end.puzzle
##                                                 ^ - invalid
##                                                   ^^^^ - invalid
##                                                         ^ punctuation.section.embedded.begin.puzzle
##                                                          ^ punctuation.definition.keyword.puzzle
##                                                           ^^^ keyword.control.end.puzzle
##                                                              ^ punctuation.section.embedded.end.puzzle

    ## content after the keyword is allowed and ignored

    {#raw json}x{/raw}
    ##^^^ keyword.control.raw.puzzle
    ##    ^^^^ comment.other.raw-opener.puzzle
    ##        ^ punctuation.section.embedded.end.puzzle
    ##            ^^^ keyword.control.end.puzzle

    ## the closer tolerates whitespace around its keyword

    {#raw}a{/ raw }
    ##^^^ keyword.control.raw.puzzle
    ##     ^ punctuation.section.embedded.begin.puzzle
    ##      ^ punctuation.definition.keyword.puzzle
    ##        ^^^ keyword.control.end.puzzle
    ##            ^ punctuation.section.embedded.end.puzzle

    ## HTML stays structural inside the body, and every attribute is literal

    {#raw}<b class="hi">x</b><button @click={ handler } ref="r">y</button>{/raw}
    ##     ^ entity.name.tag.inline.any.html
    ##       ^^^^^ entity.other.attribute-name.html
    ##              ^^ string.quoted.double.html
    ##                        ^^^^^^ entity.name.tag.inline.form.html
    ##                               ^^^^^^ entity.other.attribute-name.html
    ##                               ^^^^^^ - keyword.operator.event.puzzle
    ##                                      ^ - punctuation.section.embedded.begin.puzzle
    ##                                        ^^^^^^^ - source.js.embedded.puzzle
    ##                                                  ^^^ entity.other.attribute-name.html
    ##                                                  ^^^ - entity.other.attribute-name.directive.puzzle
    ##                                                             ^^^^^^ entity.name.tag.inline.form.html
    ##                                                                      ^^^ keyword.control.end.puzzle

    ## a braced attribute value is one opaque span, and a brace inside a
    ## quoted string does not end it -- the value runs to its balanced close

    {#raw}<b d={ {"t": "}"} }>x</b>{/raw}
    ##     ^ entity.name.tag.inline.any.html
    ##       ^ entity.other.attribute-name.html
    ##         ^^^^^^^^^^^^^^ string.unquoted.html
    ##                  ^ string.unquoted.html
    ##                      ^ - entity.other.attribute-name.html
    ##                       ^ punctuation.definition.tag.end.html
    ##                               ^^^ keyword.control.end.puzzle

    {#raw}<b d={ {'t': '}'} }>x</b>{/raw}
    ##     ^ entity.name.tag.inline.any.html
    ##         ^^^^^^^^^^^^^^ string.unquoted.html
    ##                  ^ string.unquoted.html
    ##                      ^ - entity.other.attribute-name.html
    ##                       ^ punctuation.definition.tag.end.html
    ##                               ^^^ keyword.control.end.puzzle

    ## the same at a text position: a lone brace in the body is inert bytes
    ## and only the closer ends the block

    {#raw}{ "a": "}" }{/raw}
    ##    ^^^^^^^^^^^^ meta.block.raw.puzzle
    ##            ^ - punctuation.section.embedded.end.puzzle
    ##               ^ - keyword.control.end.puzzle
    ##                ^ punctuation.section.embedded.begin.puzzle
    ##                  ^^^ keyword.control.end.puzzle

    ## markers and components are plain elements in a raw body

    {#raw}<Slot/><Portal>x</Portal><Card/><slot></slot>{/raw}
    ##     ^^^^ - entity.name.tag.marker.puzzle
    ##            ^^^^^^ - entity.name.tag.marker.puzzle
    ##            ^^^^^^ entity.name.tag.other.html
    ##                              ^^^^ entity.name.tag.other.html
    ##                                     ^^^^ - invalid.illegal.marker.puzzle
    ##                                                   ^^^ keyword.control.end.puzzle

    ## an HTML comment in a raw body is still a comment

    {#raw}<!-- note -->{/raw}
    ##    ^^^^^^^^^^^^^ comment.block.html
    ##                   ^^^ keyword.control.end.puzzle

    ## a raw block only ends at a real closer, so nested block tags stay text

    {#raw}{/if}{/comment}{/raw}
    ##      ^^ - keyword.control.end.puzzle
    ##           ^^^^^^^ - keyword.control.end.puzzle
    ##                     ^^^ keyword.control.end.puzzle

    ## a raw block in an attribute value is a compile error

    <div class="a {#raw}x"></div>
    ##            ^^^^^^ invalid.illegal.raw-in-attribute.puzzle


    ## --- Brace escapes: \{ and \} --- text AND attribute values

    ## the lexer drops the backslash and emits the literal brace, so \{ never
    ## opens an interpolation

    Use \{ braces \} literally
    ##  ^^ constant.character.escape.puzzle
    ##            ^^ constant.character.escape.puzzle
    ##   ^ - punctuation.section.embedded.begin.puzzle
    ##     ^^^^^^ - source.js.embedded.puzzle

    ## an attribute value escapes the same way -- buildAttr feeds every quoted
    ## and unquoted value through parseAttrParts, whose parseSequence does the
    ## same unescape, so this is how a literal brace is written in an attribute

    <input pattern="[0-9]\{5\}" title="a \{ b \}">
    ##                   ^^ constant.character.escape.puzzle
    ##                      ^^ constant.character.escape.puzzle
    ##                     ^ - meta.interpolation.puzzle
    ##                                   ^^ constant.character.escape.puzzle
    ##                                        ^^ constant.character.escape.puzzle

    ## class/id/href reach the expression grammar through a different HTML
    ## extension point (strings-common-content), so pin one of those too

    <p class="a \{ b \}">x</p>
    ##          ^^ constant.character.escape.puzzle
    ##               ^^ constant.character.escape.puzzle
    ##             ^ - meta.interpolation.puzzle

    ## an unquoted value takes the same token path

    <input pattern=a\{b>
    ##              ^^ constant.character.escape.puzzle

    ## a brace-only value is a JS expression, not an attribute mini-grammar
    ## value, so nothing inside it is a Puzzle brace escape

    <p data-x={ '\{' }>y</p>
    ##           ^^ - constant.character.escape.puzzle

    ## a raw body gets no escape either: lexRawText does no backslash handling,
    ## and buildAttr short-circuits every raw token to a verbatim value

    {#raw}a \{ b{/raw}
    ##      ^^ - constant.character.escape.puzzle
    ##            ^^^ keyword.control.end.puzzle

    {#raw}<b pattern="a\{b">x</b>{/raw}
    ##                 ^^ - constant.character.escape.puzzle


    ## --- Expressions are JavaScript-shaped (D176) --- calls, methods, arrow
    ## functions as arguments, template literals, object and array literals, `??`
    ## and `?.` read with JavaScript's own scopes; a function-library name called
    ## bare gets the library scope

    <p>{ currency(price) } { truncate(post.body, 120) } { name.trim().toUpperCase() }</p>
##       ^^^^^^^^ support.function.library.puzzle
##       ^^^^^^^^ meta.function-call.js
##               ^ punctuation.section.group.begin.js
##                           ^^^^^^^^ support.function.library.puzzle
##                                               ^^^ constant.numeric
##                                                             ^^^^ variable.function.js
##                                                             ^^^^ - support.function.library.puzzle
##                                                                    ^^^^^^^^^^^ meta.function-call.js
##                                                                    ^^^^^^^^^^^ - invalid
##                                                                                 ^^^^^^ - invalid
    {#for t in todos.filter(t => !t.done)}<i>{ t.title }</i>{/for}
##                   ^^^^^^ meta.function-call.js
##                            ^^ keyword.declaration.function.arrow.js
##                               ^ keyword.operator.logical.js
##                                       ^ punctuation.section.embedded.end.puzzle
    <p title={ `${first} ${last}` }>{ `Total: ${ currency(total) }` }</p>
##             ^ string.quoted.other.js
##              ^^ punctuation.section.interpolation.begin.js
##                                               ^^^^^^^^ support.function.library.puzzle
##                                                                ^ string.quoted.other.js
##                                                                 ^^^^^^ - invalid
##                                                                  ^ punctuation.section.embedded.end.puzzle
    <p>{ t('cart.count', { count: items.length }) } { [a, b].join(', ') } { user?.name ?? 'Guest' }</p>
##       ^ support.function.library.puzzle
##       ^ meta.function-call.js
##                       ^ punctuation.section.mapping.begin.js
##                       ^ - punctuation.section.embedded.begin.puzzle
##                                      ^^^^^^ - invalid
##                                             ^ punctuation.section.mapping.end.js
##                                              ^ punctuation.section.group.end.js
##                                                ^ punctuation.section.embedded.end.puzzle
##                                                    ^ punctuation.section.sequence.begin.js
##                                                           ^^^^ meta.function-call.js
##                                                                              ^^ punctuation.accessor.js
##                                                                                     ^^ keyword.operator.null-coalescing.js
    <p>{ capitalize(truncate(title, 20)) } { time(in_timezone(d, zone)) } { Math.round(x * 100) / 100 }</p>
##       ^^^^^^^^^^ support.function.library.puzzle
##                  ^^^^^^^^ support.function.library.puzzle
##                                           ^^^^ support.function.library.puzzle
##                                                ^^^^^^^^^^^ support.function.library.puzzle
##                                                                          ^^^^ support.constant.builtin.js
##                                                                               ^^^^^ - support.function.library.puzzle

    ## every library function gets the scope when it is called bare

    { round(n) } { currency(n) } { percentage(n) } { number_with_delimiter(n) } { compact_number(n) }
##    ^^^^^ support.function.library.puzzle
##                 ^^^^^^^^ support.function.library.puzzle
##                                 ^^^^^^^^^^ support.function.library.puzzle
##                                                   ^^^^^^^^^^^^^^^^^^^^^ support.function.library.puzzle
##                                                                                ^^^^^^^^^^^^^^ support.function.library.puzzle
    { pluralize(n, 'item') } { capitalize(s) } { truncate(s, 9) } { strip_html(s) } { strip_newlines(s) }
##    ^^^^^^^^^ support.function.library.puzzle
##                             ^^^^^^^^^^ support.function.library.puzzle
##                                               ^^^^^^^^ support.function.library.puzzle
##                                                                  ^^^^^^^^^^ support.function.library.puzzle
##                                                                                    ^^^^^^^^^^^^^^ support.function.library.puzzle
    { escape(s) } { json(v) } { date(d) } { time(d) } { datetime(d, 'short') } { in_timezone(d, z) }
##    ^^^^^^ support.function.library.puzzle
##                  ^^^^ support.function.library.puzzle
##                              ^^^^ support.function.library.puzzle
##                                          ^^^^ support.function.library.puzzle
##                                                      ^^^^^^^^ support.function.library.puzzle
##                                                                               ^^^^^^^^^^^ support.function.library.puzzle
    { t('k') } { link(url) } { timeago(d) } { raw(h) } { newline_to_br(s) }
##    ^ support.function.library.puzzle
##               ^^^^ support.function.library.puzzle
