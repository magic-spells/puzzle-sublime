## SYNTAX TEST "Puzzle.sublime-syntax"

<puzzle-view class="shell">
##^^^^^^^^^^ entity.name.tag.section.puzzle
##           ^^^^^ entity.other.attribute-name.class.html

  <article
 ##^^^^^^^ entity.name.tag.block.any.html
    id="profile"
  ##^^ entity.other.attribute-name.id.html
    data-user={ user.id }
  ##^^^^^^^^^ entity.other.attribute-name.html
    ##        ^ punctuation.section.embedded.begin.puzzle
    ##             ^^^^ source.js.embedded.puzzle
    style="{#if visible}opacity:{ opacity };{/if} transform:translateX({ offset }px)">
  ##^^^^^ entity.other.attribute-name.style.html
    ##     ^ punctuation.section.embedded.begin.puzzle
    ##      ^ punctuation.definition.keyword.puzzle
    ##       ^^ keyword.control.conditional.puzzle
    ##                  ^^^^^^^ support.type.property-name.css
    ##                          ^ punctuation.section.embedded.begin.puzzle
    ##                           ^^^^^^^ source.js.embedded.puzzle

    <!-- {#if examplesInComments} stays a comment {/if} -->
  ##^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ comment.block.html
    ##      ^ - meta.embedded.block.puzzle

    <ArtistCard @click:prevent:stop={ openArtist(artist, event) } />
   ##^^^^^^^^^^ entity.name.tag.component.puzzle
    ##          ^ keyword.operator.event.puzzle
    ##           ^^^^^ entity.other.attribute-name.event.puzzle
    ##                ^ punctuation.separator.modifier.puzzle
    ##                 ^^^^^^^ support.constant.event-modifier.puzzle
    ##                        ^ punctuation.separator.modifier.puzzle
    ##                         ^^^^ support.constant.event-modifier.puzzle
    ##                              ^ punctuation.section.embedded.begin.puzzle

    <button @click.prevent={ broken } @click:bogus={ alsoBroken }>
    ##      ^ keyword.operator.event.puzzle
    ##       ^^^^^ entity.other.attribute-name.event.puzzle
    ##            ^^^^^^^^ invalid.illegal.event-modifier.puzzle
    ##                                ^ keyword.operator.event.puzzle
    ##                                 ^^^^^ entity.other.attribute-name.event.puzzle
    ##                                      ^ punctuation.separator.modifier.puzzle
    ##                                       ^^^^^ invalid.illegal.event-modifier.puzzle
      Open
    </button>

    {#if user.active && !user.suspended}
  ##^ punctuation.section.embedded.begin.puzzle
   ##^ punctuation.definition.keyword.puzzle
    ##^^ keyword.control.conditional.puzzle
    ##      ^^^^ source.js.embedded.puzzle
    ##                  ^ keyword.operator.logical.js
      <strong>{ user.name | trim | capitalize }</strong>
      ##      ^ punctuation.section.embedded.begin.puzzle
      ##                  ^ keyword.operator.formatter.puzzle
      ##                    ^^^^ variable.function.formatter.puzzle
      ##                         ^ keyword.operator.formatter.puzzle
      ##                           ^^^^^^^^^^ variable.function.formatter.puzzle
    {:else if user.pending}
  ##^ punctuation.section.embedded.begin.puzzle
   ##^ punctuation.definition.keyword.puzzle
    ##^^^^ keyword.control.conditional.else.puzzle
    ##     ^^ keyword.control.conditional.if.puzzle
      <span>Pending</span>
    {:else}
   ##^ punctuation.definition.keyword.puzzle
    ##^^^^ keyword.control.conditional.else.puzzle
      <span>Inactive</span>
    {/if}
   ##^ punctuation.definition.keyword.puzzle
    ##^^ keyword.control.end.puzzle

    {#unless hidden}
   ##^ punctuation.definition.keyword.puzzle
    ##^^^^^^ keyword.control.conditional.puzzle
      <span>Visible</span>
    {/unless}
    ##^^^^^^ keyword.control.end.puzzle

    {#case status}
   ##^ punctuation.definition.keyword.puzzle
    ##^^^^ keyword.control.conditional.puzzle
      {:when 'playing', 'paused'}<span>{ status }</span>
     ##^ punctuation.definition.keyword.puzzle
      ##^^^^ keyword.control.conditional.puzzle
      ##     ^^^^^^^^^ source.js.embedded.puzzle string.quoted.single.js
      {:else}<span>Unknown</span>
    {/case}
    ##^^^^ keyword.control.end.puzzle

    {#for track in tracks, i}
   ##^ punctuation.definition.keyword.puzzle
    ##^^^ keyword.control.loop.puzzle
    ##          ^^ keyword.operator.js
      <span>{ i }: { track.title }</span>
    {/for}
    ##^^^ keyword.control.end.puzzle

    {#for 1...4, n}<i>{ n }</i>{/for}
    ##        ^ constant.numeric.value.js
    ##     ^^^ keyword.operator.range.puzzle
    ##        ^ constant.numeric.value.js
    ##                           ^^^ keyword.control.end.puzzle

    {#svg 'icons/heart.svg'}
   ##^ punctuation.definition.keyword.puzzle
    ##^^^ support.function.inline-svg.puzzle
    ##    ^^^^^^^^^^^^^^^^^ string.quoted.single.js

    <p title="Hello { user.name }">{ count || fallback }</p>
    ##              ^ punctuation.section.embedded.begin.puzzle
    ##                  ^^^^ source.js.embedded.puzzle
    ##                                     ^^ keyword.operator.logical.js
    ##                                        ^^ - keyword.operator.formatter.puzzle


    ## --- Template comments (v1.37, D70) --- stripped by compiler, never parsed

    {## a simple comment }
  ##^^^ comment.block.template.puzzle
  ##^ punctuation.definition.comment.begin.puzzle
    ##    ^^^^^^ comment.block.template.puzzle
    ##                   ^ punctuation.definition.comment.end.puzzle

    {## don't { x } \} end }
    ##     ^ comment.block.template.puzzle
    ##        ^ comment.block.template.puzzle
    ##            ^ comment.block.template.puzzle
    ##              ^^ comment.block.template.puzzle
    ##               ^ - punctuation.definition.comment.end.puzzle
    ##                     ^ punctuation.definition.comment.end.puzzle

    {#comment} { x } {#if a}z{/if} <!-- h --> {/comment}
  ##^^^^^^^^^ comment.block.puzzle
  ##^^^ punctuation.definition.comment.begin.puzzle
    ##         ^^^^^ comment.block.puzzle
    ##                 ^^ comment.block.puzzle
    ##                 ^^ - keyword.control.conditional.puzzle
    ##                             ^^^^ comment.block.puzzle
    ##                                        ^ punctuation.definition.comment.end.puzzle
    ##                                                 ^ punctuation.definition.comment.end.puzzle

    {#comment} outer {#comment} inner {/comment} outer {/comment}
  ##^^^^^^^^^ comment.block.puzzle
    ##               ^^^^^^^^^ comment.block.puzzle
    ##               ^^^ punctuation.definition.comment.begin.puzzle
    ##                          ^^^^^ comment.block.puzzle
    ##                                ^ punctuation.definition.comment.end.puzzle
    ##                                           ^^^^^ comment.block.puzzle
    ##                                                 ^ punctuation.definition.comment.end.puzzle

    {#comment note} body {/ comment }
  ##^^^^^^^^^ comment.block.puzzle
    ##        ^^^^ comment.block.puzzle
    ##              ^^^^ comment.block.puzzle
    ##                   ^ punctuation.definition.comment.end.puzzle
    ##                              ^ punctuation.definition.comment.end.puzzle

    {#commentary}
   ##^ punctuation.definition.keyword.puzzle
    ##^^^^^^^^^^ invalid.illegal.directive.puzzle
    ##^^^^^^^^^^ - comment.block.puzzle


    ## --- Paired composition markers (D141) --- Children, Slot and Portal are
    ## reserved markers, not components; fallback bodies are ordinary content

    <Slot name="header"><h2>{ title | capitalize }</h2></Slot>
   ##^^^^ entity.name.tag.marker.puzzle
   ##^^^^ - entity.name.tag.component.puzzle
    ##                      ^ punctuation.section.embedded.begin.puzzle
    ##                        ^^^^^ source.js.embedded.puzzle
    ##                              ^ keyword.operator.formatter.puzzle
    ##                                ^^^^^^^^^^ variable.function.formatter.puzzle
    ##                                                   ^^^^ entity.name.tag.marker.puzzle
    <Children>
   ##^^^^^^^^ entity.name.tag.marker.puzzle
      {#if items.length}<ItemCard item={ items[0] } />{:else}<p>plain</p>{/if}
      ##^^ keyword.control.conditional.puzzle
      ##   ^^^^^^^^^^^^ source.js.embedded.puzzle
      ##                 ^^^^^^^^ entity.name.tag.component.puzzle
      ##                                 ^^^^^^^^ source.js.embedded.puzzle
      ##                                                ^^^^ keyword.control.conditional.else.puzzle
      ##                                                        ^^^^^ - source.js.embedded.puzzle
      ##                                                                   ^^ keyword.control.end.puzzle
    </Children>
    ##^^^^^^^^ entity.name.tag.marker.puzzle

    <Slot>{ count | number } left{#svg 'icons/empty.svg'}</Slot>
   ##^^^^ entity.name.tag.marker.puzzle
    ##      ^^^^^ source.js.embedded.puzzle
    ##              ^^^^^^ variable.function.formatter.puzzle
    ##                       ^^^^ - source.js.embedded.puzzle
    ##                             ^^^ support.function.inline-svg.puzzle
    ##                                                     ^^^^ entity.name.tag.marker.puzzle

    <Children/><Slot name="footer"/>
   ##^^^^^^^^ entity.name.tag.marker.puzzle
    ##          ^^^^ entity.name.tag.marker.puzzle

    <Portal><div class="dialog">{ message }</div></Portal>
   ##^^^^^^ entity.name.tag.marker.puzzle
    ##       ^^^ entity.name.tag.block.any.html
    ##                          ^ punctuation.section.embedded.begin.puzzle
    ##                            ^^^^^^^ source.js.embedded.puzzle
    ##                                             ^^^^^^ entity.name.tag.marker.puzzle

    ## a capitalized name that merely starts with a marker word is a component

    <Slotted/><PortalHost/>
   ##^^^^^^^ entity.name.tag.component.puzzle
    ##         ^^^^^^^^^^ entity.name.tag.component.puzzle


    ## --- Lowercase marker spellings are compile errors (D134/D144) ---

    <slot></slot><children/><portal></portal>
   ##^^^^ invalid.illegal.marker.puzzle
   ##^^^^ - entity.name.tag.block.any.html
    ##      ^^^^ invalid.illegal.marker.puzzle
    ##            ^^^^^^^^ invalid.illegal.marker.puzzle
    ##                       ^^^^^^ invalid.illegal.marker.puzzle
    ##                                ^^^^^^ invalid.illegal.marker.puzzle


    ## --- Directive attributes --- intercepted by the compiler, never DOM

    <li key={ item.id } ref="row" island flip>
    ##  ^^^ entity.other.attribute-name.directive.puzzle
    ##      ^ punctuation.section.embedded.begin.puzzle
    ##        ^^^^^^^ source.js.embedded.puzzle
    ##                  ^^^ entity.other.attribute-name.directive.puzzle
    ##                      ^^^^^ string.quoted.double.html
    ##                            ^^^^^^ entity.other.attribute-name.directive.puzzle
    ##                                   ^^^^ entity.other.attribute-name.directive.puzzle
      done
    </li>

    <tr key="row-{ i }" flip={ track.id }>
    ##  ^^^ entity.other.attribute-name.directive.puzzle
    ##           ^ punctuation.section.embedded.begin.puzzle
    ##             ^ source.js.embedded.puzzle
    ##                  ^^^^ entity.other.attribute-name.directive.puzzle
    ##                         ^^^^^^^^ source.js.embedded.puzzle
      <td>cell</td>
    </tr>

    ## a directive word inside a longer name stays a plain attribute

    <div data-ref="x" keyboard="y"></div>
    ##   ^^^^^^^^ - entity.other.attribute-name.directive.puzzle
    ##                ^^^^^^^^ - entity.other.attribute-name.directive.puzzle


    ## --- The outside event modifier (v1.52, D86) is event-generic ---

    <div @click:outside={ close } @pointerdown:outside:once={ close }>
    ##   ^ keyword.operator.event.puzzle
    ##    ^^^^^ entity.other.attribute-name.event.puzzle
    ##         ^ punctuation.separator.modifier.puzzle
    ##          ^^^^^^^ support.constant.event-modifier.puzzle
    ##                            ^ keyword.operator.event.puzzle
    ##                             ^^^^^^^^^^^ entity.other.attribute-name.event.puzzle
    ##                                        ^ punctuation.separator.modifier.puzzle
    ##                                         ^^^^^^^ support.constant.event-modifier.puzzle
    ##                                                ^ punctuation.separator.modifier.puzzle
    ##                                                 ^^^^ support.constant.event-modifier.puzzle
    </div>

    <div @click.outside={ broken }></div>
    ##         ^^^^^^^^ invalid.illegal.event-modifier.puzzle


    ## --- Raw blocks (D150) --- braces inert, HTML still structural

    {#raw}{ "loop": true } {#if x}{:else}{/if} { a | upper }{/raw}
  ##^ punctuation.section.embedded.begin.puzzle
   ##^ punctuation.definition.keyword.puzzle
    ##^^^ keyword.control.raw.puzzle
    ##   ^ punctuation.section.embedded.end.puzzle
    ##    ^ - punctuation.section.embedded.begin.puzzle
    ##      ^^^^^^ - source.js.embedded.puzzle
    ##                       ^^ - keyword.control.conditional.puzzle
    ##                              ^^^^ - keyword.control.conditional.else.puzzle
    ##                                     ^^ - keyword.control.end.puzzle
    ##                                             ^ - keyword.operator.formatter.puzzle
    ##                                               ^^^^^ - variable.function.formatter.puzzle
    ##                                                      ^ punctuation.section.embedded.begin.puzzle
    ##                                                       ^ punctuation.definition.keyword.puzzle
    ##                                                        ^^^ keyword.control.end.puzzle
    ##                                                           ^ punctuation.section.embedded.end.puzzle

    ## content after the keyword is allowed and ignored

    {#raw json}x{/raw}
    ##^^^ keyword.control.raw.puzzle
    ##    ^^^^ comment.other.raw-opener.puzzle
    ##        ^ punctuation.section.embedded.end.puzzle
    ##            ^^^ keyword.control.end.puzzle

    ## the closer tolerates whitespace around its keyword

    {#raw}a{/ raw }
    ##^^^ keyword.control.raw.puzzle
    ##     ^ punctuation.section.embedded.begin.puzzle
    ##      ^ punctuation.definition.keyword.puzzle
    ##        ^^^ keyword.control.end.puzzle
    ##            ^ punctuation.section.embedded.end.puzzle

    ## HTML stays structural inside the body, and every attribute is literal

    {#raw}<b class="hi">x</b><button @click={ handler } ref="r">y</button>{/raw}
    ##     ^ entity.name.tag.inline.any.html
    ##       ^^^^^ entity.other.attribute-name.html
    ##              ^^ string.quoted.double.html
    ##                        ^^^^^^ entity.name.tag.inline.form.html
    ##                               ^^^^^^ entity.other.attribute-name.html
    ##                               ^^^^^^ - keyword.operator.event.puzzle
    ##                                      ^ - punctuation.section.embedded.begin.puzzle
    ##                                        ^^^^^^^ - source.js.embedded.puzzle
    ##                                                  ^^^ entity.other.attribute-name.html
    ##                                                  ^^^ - entity.other.attribute-name.directive.puzzle
    ##                                                             ^^^^^^ entity.name.tag.inline.form.html
    ##                                                                      ^^^ keyword.control.end.puzzle

    ## markers and components are plain elements in a raw body

    {#raw}<Slot/><Portal>x</Portal><Card/><slot></slot>{/raw}
    ##     ^^^^ - entity.name.tag.marker.puzzle
    ##            ^^^^^^ - entity.name.tag.marker.puzzle
    ##            ^^^^^^ entity.name.tag.other.html
    ##                              ^^^^ entity.name.tag.other.html
    ##                                     ^^^^ - invalid.illegal.marker.puzzle
    ##                                                   ^^^ keyword.control.end.puzzle

    ## an HTML comment in a raw body is still a comment

    {#raw}<!-- note -->{/raw}
    ##    ^^^^^^^^^^^^^ comment.block.html
    ##                   ^^^ keyword.control.end.puzzle

    ## a raw block only ends at a real closer, so nested block tags stay text

    {#raw}{/if}{/comment}{/raw}
    ##      ^^ - keyword.control.end.puzzle
    ##           ^^^^^^^ - keyword.control.end.puzzle
    ##                     ^^^ keyword.control.end.puzzle

    ## a raw block in an attribute value is a compile error

    <div class="a {#raw}x"></div>
    ##            ^^^^^^ invalid.illegal.raw-in-attribute.puzzle

  </article>
</puzzle-view>
##^^^^^^^^^^^ entity.name.tag.section.puzzle

<puzzle-skeleton min-duration="300">
##^^^^^^^^^^^^^^ entity.name.tag.section.puzzle
##               ^^^^^^^^^^^^ entity.other.attribute-name.html
  {#for 1...3, n}<div class="placeholder"></div>{/for}
  ##     ^^^ keyword.operator.range.puzzle

    {## skeleton note }
  ##^^^ comment.block.template.puzzle
    ##  ^^^^^^^^ comment.block.template.puzzle
    ##                ^ punctuation.definition.comment.end.puzzle
</puzzle-skeleton>
##^^^^^^^^^^^^^^^ entity.name.tag.section.puzzle

<script>
##^^^^^ entity.name.tag.script.puzzle
import { PuzzleView } from '@magic-spells/puzzle';
## <- source.js.embedded.puzzle

export default class Example extends PuzzleView {
  data() {
    return { bitmask: 1 | 2, logical: true || false };
    ##                  ^ keyword.operator.bitwise.js
    ##                                     ^^ keyword.operator.logical.js
  }
}
</script>
##^^^^^^ entity.name.tag.section.puzzle

<script lang="ts">
##^^^^^ entity.name.tag.script.puzzle
##      ^^^^ entity.other.attribute-name.html
interface User {
## <- source.ts.embedded.puzzle
  id: number;
}
const user: User = { id: 1 };
</script>
##^^^^^^ entity.name.tag.section.puzzle

<style scoped>
##^^^^ entity.name.tag.style.puzzle
##     ^^^^^^ entity.other.attribute-name.html
@scope (.card) {
## <- source.css.embedded.puzzle
  .title:hover { color: rebeccapurple; }
}
</style>
